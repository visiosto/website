    "@eslint/markdown": "7.5.1",
    "@prettier/plugin-xml": "3.4.2",
    "@tailwindcss/vite": "4.2.2",
    "browserslist": "4.28.1",
    "eslint": "10.1.0",
    "eslint-plugin-astro": "1.6.0",
    "globals": "17.4.0",
    "lightningcss": "1.32.0",
    "postcss-html": "1.8.1",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-astro-organize-imports": "0.4.13",
