import Head, { type Props as HeadProps } from "@/components/Head.astro";
import Header from "@/components/Header.astro";
import { languageCodes, type Locale } from "@/locales";
import { Font } from "astro:assets";

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface Props extends HeadProps {}

const head = Astro.props;

const locale = Astro.props.errorPage ? "fi" : (Astro.currentLocale as Locale);
---

<!doctype html>
<html class="scheme-light dark:scheme-dark" lang={languageCodes[locale]}>
  <head>
    <Head {...head} />
    <Font cssVariable="--font-mona-sans" />
    <Font cssVariable="--font-mona-sans-mono" />
  </head>
  <body
    class="bg-stone-50 font-sans text-stone-950 dark:bg-stone-900 dark:text-stone-50"
  >
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>
